{
  "name": "stylist-frontend-sample",
  "version": "1.0.0",
  "private": true,
  "description": "Selected React Native frontend source and tests from Stylist, a personal fashion discovery app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "54.0.37",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "expo-image": "3.0.11",
    "expo-linear-gradient": "15.0.8",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "jest-expo": "54.0.18",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.10",
    "typescript": "5.9.3",
    "babel-preset-expo": "54.0.12",
    "react-test-renderer": "19.1.0",
    "test-renderer": "1.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
